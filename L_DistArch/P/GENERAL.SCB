'---------------------------------------
' L_DistArch - Global Configuration
'---------------------------------------
' Purpose:
'   Centralized constants for redundancy associations and
'   station list. Search UPDATE for customize your application.

'---------------------------------------
' Windows API declarations
'---------------------------------------
' These functions are used by Restart_PcVue() and GetSvPath()
' to retrieve the current process ID and executable path.
'---------------------------------------
Dim SvPath          As Str;    ' Full path to sv32.exe (PcVue runtime)
Dim MyId            As Long;   ' Current PcVue process ID
Dim SvProjectPath   As Str;    ' Full path to project directory
Dim SvProjectName   As Str;    ' Name of the current SCADA project
Dim strCentralPath  As Str;    ' Path to central shared folder (managed projects)


Declare Function GetCurrentProcessId Lib "kernel32" Alias "GetCurrentProcessId" () As Long;
Declare Function GetModuleFileNameEx Lib "psapi.dll" Alias "GetModuleFileNameExA" (hProcess As Long, hModule As Long, lpFilename As Long, nSize As Long) As Long;
Declare Function OpenProcess Lib "kernel32" (dwDesiredAccess As Long, bInheritHandle As Long, dwProcessId As Long) As Long;
Declare Function CloseHandle Lib "kernel32" (hObject As Long) As Long;

'---------------------------------------
' GetElement
'---------------------------------------
' Purpose:
'   Return an element in a string (first, last or other element)
'
' Arguments:
'   strExpression is a string, ie: a variable name
'   delimiter is a string, ie: "." or ","...
'   position is a number, ie: -1, 1, ..., 12... (first is 1, last is -1)
'
'---------------------------------------

Sub GetElement(strExpression, delimiter, position)
Dim lngBuffer1 as Long;  ' Buffer to hold the expression string
Dim strResult as Str;    ' Result string (single element)

	' Allocate buffer and load expression string
	lngBuffer1 = Alloc_Buffer(Len(strExpression));
	Put_Buffer(lngBuffer1, 0, strExpression);
	
	' Extract element at specified position
	IF (position == -1) Then
		' Position -1 means "last element"
		strResult = Asciifield("STR", lngBuffer1, Asciifield("COUNT", lngBuffer1, delimiter) , delimiter);
	ELSE
		' Get element at specific position (1-based)
		strResult = Asciifield("STR", lngBuffer1, position , delimiter);
	End If

	' Free memory and return result
	Free_Buffer(lngBuffer1);
	Return(strResult);
	
End Sub

'---------------------------------------
' GetCentralPath
'---------------------------------------
' Purpose:
'   Return central project management folder
'---------------------------------------

Sub GetCentralPath()
Dim FileName as Str;
Dim strLine as str;
Dim strResult as Str;
Dim strElement as Str;
Dim lngBufFile as Long;
Dim lngBuffer2 as Long;
Dim i as Integer;

	FileName = Left(GetProjectDir(), Len(GetProjectDir()) - 4 - Len(SvProjectName)); ' {data} folder (usr, etc, lib, databases.)
	FileName = AddString(FileName, "etc\\ini.dat");

	lngBufFile = FileToBuf(FileName);
	i = Seq_Buffer("BEGIN", lngBufFile);
	
	While (i != 0)
		'Read lines
		strLine = Seq_Buffer("NEXTFIELD", lngBufFile, "\n", "STR");
		strElement = GetElement(strLine, ",", 1);
		
		If (CmpString(strElement, "CENTRAL")==0) Then
			strResult = GetElement(strLine, ",", 2);
			Break;
		End If
		
		lngbuffer2 = ALLOC_BUFFER(110);
		'test if next field exist
		i = Seq_Buffer("SEEKFIELD", 1, lngBufFile, "\n");
		'move cursor back to previous position
		Seq_Buffer("SEEKFIELD", -1, lngBufFile, "\n");		
		Free_Buffer(lngBuffer2);
	Wend
	Free_Buffer(lngBufFile);
	
	Return(strResult);
	
End Sub

'---------------------------------------
' Entry point
'---------------------------------------
' Sub Main() is automatically executed at startup.
' It schedules cyclic tasks and delayed initialization.
'---------------------------------------

Sub Main()
    ' === INITIALIZE GLOBAL VARIABLES ===
    ' Retrieve process and project information from Windows API
    MyId = GetCurrentProcessId();              ' Current PcVue runtime process ID
    SvProjectPath = GetProjectDir();           ' Full path to project directory
	SvProjectName = GetElement(GetProjectDir(),"\\",-1);  ' Extract project name from path
    SvPath = AddString(GetApplicationDir(), "\\sv32.exe");  ' Full path to runtime executable
	StrCentralPath = GetCentralPath();         ' Central project management folder

	' === SCHEDULE CYCLIC TASKS ===
    ' Delay loading of Main2() to allow system initialization (10-second delay)
    CYCLIC("ADDPROG", 10, "L_DistArch/GENERAL.SCB", "", "Main2");
    
    ' Preload Networking module for redundancy management
    Program("PRELOAD", "L_DistArch/Networking.SCB", "");

End Sub


'---------------------------------------
' Main2
'---------------------------------------
' Purpose:
'   Secondary initialization routine executed after delay.
'   - Manage Dual display
'   - Cleans up cyclic delay started in Main()
'---------------------------------------

Sub Main2()
    ' === OPTIONAL DUAL DISPLAY ===
    ' Optional dual monitor activation (currently disabled)
    ' Uncomment DualDisplay() to enable:
    ' DualDisplay()
    
    ' === CLEANUP ===
    ' Remove the delayed cyclic task scheduled in Main() (10-second delay)
    CYCLIC("DEL_EX", 10, "L_DistArch/GENERAL.SCB", "", "Main2");
    
    ' === LOG INITIALIZATION ===
    ' Log module initialization
    TRACE("LOG", "***** L_DistArch : Client-Server Management module loaded ***");

End Sub


'---------------------------------------
' UserReload
'---------------------------------------
' Purpose:
'   Event routine that manages:
'   - Reload of user file USER.DAT (USER_RELOAD variable)
'
' Variables:
'   <Architecture>.<Station>.USER_RELOAD  - Reload trigger for user.dat
'
' Notes: 
'   - Variables are defined in Application Architect.
'   - Batch "user_load.bat" must exist in library folder \TP\
'     This copies the updated user.dat from the central folder to the
'     local station's project directory.
'---------------------------------------

Sub UserReload()

    Dim LoadCmd         As Str;    ' Full path to user_load.bat
    Dim VarRunningMode  As Str;    ' Running mode variable name
    Dim RunningMode     As Single; ' Running mode value (1=Console, 2=Service, 3=RDS)
    Dim strConcatArg 	As Str;    ' Arguments for batch file

    '-----------------------------------
    ' User reload management
    '-----------------------------------

	' === BUILD BATCH ARGUMENTS ===
	' Arguments format: "<CentralPath>\<ProjectName>" "<LocalProjectPath>"
	strConcatArg = ADDSTRING("\"", strCentralPath, "\\", SvProjectName, "\"", " ", "\"", SvProjectPath, "\"");

    ' Build batch file path: <ProjectDir>\LIB\L_DistArch\TP\user_load.bat
    ' This batch copies updated user.dat from central folder to local station
    LoadCmd = ADDSTRING(GETPROJECTDIR(), "\\LIB\\L_DistArch\\TP\\user_load.bat");

    ' Log the reload operation
    TRACE("LOG", ADDSTRING("UserReload: reload user.dat --> ", LoadCmd," --> ",strConcatArg));
        
	' === EXECUTE USER RELOAD ===
	' Execute batch to reload user.dat from central folder to local station
	APPLICATION("LOAD", LoadCmd, strConcatArg);

    ' === RESET TRIGGER ===
    ' Reset USER_RELOAD variable to 0 (acknowledge completion)
    Set(GetArg("VARNAME"), 0);
    Sendlist("BLOC");

End Sub


'---------------------------------------
' Restart_PcVue
'---------------------------------------
' Purpose:
'   Restart PcVue runtime in different scenarios:
'   - Manual reset requested (LAN.<Station>.RESET)
'   - Service restart if running as Windows Service
'   - RDS (Remote Desktop Session) adjustments
'   - Normal restart using svrestart.exe
'
' Notes:
'   - Uses Windows API (GetCurrentProcessId, GetSvPath)
'   - Requires svrestart.exe in library folder \TP\
'   - If user is online, restart is postponed
'---------------------------------------

Sub Restart_PcVue()

    Dim SvProjectsPath  As Str;    ' Base projects path
    Dim SvRestartPath   As Str;    ' Full path to svrestart.exe
    Dim CommandLine     As Str;    ' Complete restart command to execute
    Dim Args            As Str;    ' Arguments passed to svrestart.exe
    Dim VarReset        As Str;    ' RESET variable name
    Dim LenStName       As Integer;' Length of station name (for RDS handling)
    Dim LenPrjName      As Integer;' Length of project name
    Dim LenResult       As Integer;' Calculated result length
    Dim ServiceRst      As Str;    ' Service restart command (Windows net command)
    Dim VarOverRide     As Str;    ' Override flag variable name
    Dim bVarOverRide	As integer;  ' Override flag value (0=No, 1=Yes)

    TRACE("LOG","***** L_DistArch : SCADA Reload request reiceved ****");

    '---------------------------------------
    ' Check if reload can be executed
    ' Conditions:
    '   - No user logged in ((CmpString(" ", @USER)!=0) 
    '   - Override flag set (<Architecture>.RST_OVERRIDE)
    '---------------------------------------
    VarOverRide = AddString(GetArg("ARG1"), ".RST_OVERRIDE");
    bVarOverRide = ?VarOverRide;
    
    IF ((CmpString(" ", @USER)==0) || bVarOverRide) THEN

        ' Reset <Architecture>.<Station>.RESET to 0 (acknowledge reload)
        VarReset = GetArg("VARNAME");
        ?VarReset = 0;

        ' Wait a few seconds to allow propagation across servers
        DELAY(3);

        TRACE("LOG", "***** L_DistArch : SCADA Reload in progress ****");

        ' Get process ID and paths
        MyId = GetCurrentProcessId();

        SvProjectsPath = Left ( SvProjectPath , LEN (SvProjectPath ) - LEN (ADDSTRING ("USR\\" , SvProjectName)));
        
        '---------------------------------------
        ' Remote Desktop Session handling
        ' Adjust project name by removing station suffix (_<Station>)
        '---------------------------------------
        IF (@System.LocalHost.Environment.RunningInRemoteDesktopSession == 1) THEN
        	SvProjectName = GetElement(GetProjectDir(),"\\",-1);
            LenStName = LEN(@SYSTEM.STATION_NAME); 
            LenStName=(LenStName + 1);	' Remove station name + underscore
            LenPrjName = LEN(SvProjectName);
            LenResult = (LenPrjName - LenStName);
            SvProjectName = Left(SvProjectName, LenResult);
        END IF

        '---------------------------------------
        ' Service mode handling
        ' If PcVue is running as service, restart via Windows services
        ' You must configure authorization for the user (ie .\pcvue) to restart the SV Core Session Host service.
        ' Otherwise, the service will stop but may not restart automatically.
        ' Full control over the service svCoreDeamon.exe is required.
        '---------------------------------------
        IF (@System.LocalHost.Environment.RunningAsService == 1) THEN
            ServiceRst = "net stop SvCoreDaemon && net start SvCoreDaemon";
            TRACE("LOG", ADDSTRING("***** L_DistArch : SERVICE RESTART : ", ServiceRst, " ****"));
            SYSTEM("SYSTEM", ServiceRst);
            STOP();
        END IF

        '---------------------------------------
        ' Build restart command (svrestart.exe)
        '---------------------------------------
        SvRestartPath = ADDSTRING (SvProjectPath , "\\LIB\\L_DistArch\\TP\\svrestart.exe" ); 
        SvRestartPath = ADDSTRING ("\"" , SvRestartPath); 
        SvRestartPath = ADDSTRING (SvRestartPath,"\""); 
        
        ' Build arguments for svrestart.exe:
        ' Arg1: Process ID to monitor
        ' Arg2: executable path to restart (sv32.exe)
        ' Arg3+: Optional mode flags (-WTS for RDS, -r for ref, etc.)
        Args = ADDSTRING ( " " , TOC(MyId) ); 
        Args = ADDSTRING (Args, " \""); 
        Args = ADDSTRING (Args , SvPath); 
        Args = ADDSTRING (Args , "\""); 
        Args = ADDSTRING (Args , " "); 
        Args = ADDSTRING (Args , "\"");
        
        ' RDS mode requires additional parameters
        IF (@System.LocalHost.Environment.RunningInRemoteDesktopSession == 1) THEN
        	' Use -WTS flag for Terminal Server (RDS) mode
        	Args = ADDSTRING (Args , ADDSTRING ( "-WTS ",SvProjectName ) ); 
        	Args = ADDSTRING (Args , ADDSTRING ( ",",@SYSTEM.STATION_NAME) ); 
        	Args = ADDSTRING (Args, " -r"); 
        ELSE 
        	' Standard restart flag
        	Args = ADDSTRING (Args, " -r"); 
        END IF
        
        ' Add display message for user (shown during restart)
        Args = ADDSTRING (Args , "\""); 
        Args = ADDSTRING (Args , " "); 
        Args = ADDSTRING (Args , "\""); 
        Args = ADDSTRING (Args , "Please wait, project "); 
        Args = ADDSTRING (Args , SvProjectName); 
        Args = ADDSTRING (Args , " restart in progress..."); 
        Args = ADDSTRING (Args , "\"");
        
        ' Combine path and arguments into complete command line
        CommandLine = ADDSTRING(SvRestartPath, Args);

        ' === EXECUTE RESTART ===
        ' Launch restart application
        ' Comment this line during test to avoid immediate restart
        APPLICATION("LOAD", CommandLine);

        ' Exit current PcVue process
        SYSTEM("EXIT");

    ELSE
        '---------------------------------------
        ' If user is logged in -> postpone reload        
		' Reload will be retried on next trigger        
		'---------------------------------------
        TRACE("LOG", "***** L_DistArch : User online, reload postponed... ****");
    END IF

End Sub


'---------------------------------------
' Buzzer
'---------------------------------------
' Purpose:
'   Play buzzer sound if both enable and trigger flags are active.
'
' Variables: (Todo: find a way to get variables names dynamically)
'   LAN.<Station>.EN_BUZZER  - Enable flag for buzzer
'   LAN.<Station>.BUZZER     - Trigger flag for buzzer
'
' Notes:
'   - Uses wav_player.exe located in library folder \TP\
'   - Source code available on GitHub: https://github.com/VueSurLeCode/wav_player
'   - Sound file: suonoalto.wav
'---------------------------------------

Sub Buzzer()

	Dim PlayerPath as Str; 
	Dim SoundPath as Str;
	Dim VarEnBuzzer as Str;
	Dim VarBuzzer as Str;
	Dim ret as integer;

	VarEnBuzzer=ADDSTRING(GetArg("BRANCH"),".EN_BUZZER");
	VarBuzzer=ADDSTRING(GetArg("BRANCH"),".BUZZER");

	IF (?VarEnBuzzer == 1 && ?VarBuzzer == 1) THEN

		SoundPath=ADDSTRING("\"", GETPROJECTDIR(), "\\LIB\\L_DistArch\\TP\\suonoalto.wav", "\"");
		PlayerPath=ADDSTRING(GETPROJECTDIR(), "\\LIB\\L_DistArch\\TP\\wav_player.exe");

		ret = APPLICATION("LOAD", PlayerPath, SoundPath, 5);

	END IF

End Sub


'---------------------------------------
' SetBuzzer
'---------------------------------------
' Purpose:
'   Set buzzer trigger flag (BUZZER = 1) if buzzer is enabled.
'
' Variables: (Todo: find a way to get variables names dynamically)
'   LAN.<Station>.EN_BUZZER  - Enable flag for buzzer
'   LAN.<Station>.BUZZER     - Trigger flag for buzzer
'---------------------------------------

Sub SetBuzzer()

	Dim ProjectPath as Str;
	Dim VarEnBuzzer as Str;
	Dim VarBuzzer as Str;

	VarEnBuzzer=ADDSTRING(GetArg("BRANCH"),".EN_BUZZER");
	VarBuzzer=ADDSTRING(GetArg("BRANCH"),".BUZZER");

	IF (?VarEnBuzzer == 1) THEN

		?VarBuzzer = 1;

	END IF

End Sub


'---------------------------------------
' ResetBuzzer
'---------------------------------------
' Purpose:
'   Reset buzzer trigger flag (BUZZER = 0).
'
' Variables: (Todo: find a way to get variables names dynamically)
'   LAN.<Station>.BUZZER     - Trigger flag for buzzer
'---------------------------------------

Sub ResetBuzzer()

	Dim VarEnBuzzer as Str;   ' Enable flag variable name
	Dim VarBuzzer as Str;     ' Trigger flag variable name

	' === BUILD VARIABLE NAME ===
	VarBuzzer=ADDSTRING(GetArg("BRANCH"),".BUZZER");
	
	' === RESET TRIGGER ===
	' Clear buzzer trigger flag (0 = inactive)
	?VarBuzzer = 0;

End Sub


'---------------------------------------
' UserDisconnection
'---------------------------------------
' Purpose:
'   Force user logout when <Architecture>.<Station>.USER_DISC is triggered.
'
' Variables:
'   <Architecture>.<Station>.USER_DISC  - Trigger flag for user disconnection
'
' Notes: 
'   - Trigger is defined in Application Architect.
'   - Resets USER_DISC flag to 0 after logout.
'---------------------------------------

Sub UserDisconnection()
	
	Dim strDisconn as Str;  ' USER_DISC variable name
	
	' === FORCE LOGOUT ===
	' Terminate the current user session
	SYSTEM("LOGOUT");
	TRACE("LOG",ADDSTRING("User disconnection override ",@USER));  ' Log the action
	
	' === RESET TRIGGER ===
	' Reset USER_DISC variable to 0 (acknowledge completion)
	strDisconn = GetArg("VARNAME");
	?strDisconn = 0;

End Sub


'---------------------------------------
' BroadcastUserMgt
'---------------------------------------
' Purpose:
'   Distribute user database updates (user.dat) to all stations.
'   - Runs user_copy.bat on the local station to copy user.dat 
'     into the central shared folder.
'   - Sets <Architecture>.<Station>.USER_RELOAD = 1 on all other stations,
'     triggering their reload procedure.
'
' Variables:
'   <Architecture>.<Station>.USER_RELOAD - Reload trigger for user database
'
' Notes:
'   - Station list is defined in DistArchStations.txt in TP folder.
'   - Batch file "user_copy.bat" must be present in library folder \TP\
'   - The batch uses robocopy to copy the latest user.dat to the central folder.
'   - Each client/server then reloads the updated file when USER_RELOAD = 1.
'---------------------------------------

Sub BroadcastUserMgt()

    Dim VarName as Str;
    Dim StationName as Str;
    Dim i as Integer;
    Dim CopyCommand as Str;
    Dim FileName as Str;
    Dim Line as str;
    Dim strConcatArg as Str;


	' Configuring parameters to attach to .bat file
	strConcatArg = ADDSTRING("\"", SvProjectPath, "\"", " ", "\"", strCentralPath, "\\", SvProjectName, "\"");

	CopyCommand = ADDSTRING(GETPROJECTDIR(),"\\LIB\\L_DistArch\\TP\\user_copy.bat");

	TRACE("LOG",ADDSTRING("BroadcastUserMgt: copy user.dat --> ",CopyCommand," --> ",strConcatArg));
	
	' Execute batch to copy user.dat from local station to central folder
	APPLICATION("LOAD", CopyCommand, strConcatArg);
	
	' Notify other stations to reload user.dat after few seconds
    DELAY(2);
	FileName = ADDSTRING(GETPROJECTDIR(),"\\TP\\DistArchStations.txt");

	Fopen(FileName, "r");
	
	While (Feof(FileName)==0)
		VarName = Fgets(FileName, 255);
		If (CmpString(VarName, "") == 0) Then ' last line can be empty
			Break;	' exit from while
		End If
		StationName = GetElement(VarName, ".", -1);
		print(VarName);
		
		If ((CmpString(StationName, @System.Station_name)!=0) && (CmpString(StationName, "")!=0)) Then
			VarName = AddString(VarName, ".USER_RELOAD");
			?Varname = 1;		
		End If
	Wend
	Fclose(FileName);
	

End Sub


'---------------------------------------
' DualDisplay
'---------------------------------------
' Purpose:
'   Activate dual monitor layout on specific stations.
'   - Opens main mimic "MainPage" on secondary screen (Region 2).
'   - Ensures focus returns to primary screen after execution.
'
' Variables:
'   @SYSTEM.STATION_NUMBER - Used to identify stations that require
'                            dual display (edit conditions as needed).
'
' Notes:
'   - Requires dual monitor configuration at OS level.
'   - Edit station numbers in IF condition to match project setup.
'   - Region(SETREGION, n) selects which screen region to activate.
'   - Window(OPEN, "MainPage", "") opens the mimic on the given region.
'---------------------------------------

Sub DualDisplay()

    ' Enable dual display only for selected stations
    IF ((@SYSTEM.STATION_NUMBER == 1) OR (@SYSTEM.STATION_NUMBER == 2)) THEN

        TRACE("LOG", "***** L_DistArch : Dual monitor activated ****");

        ' Switch to secondary screen (Region 2)
        REGION("SETREGION", 2);

        ' Open the main mimic on the second monitor
        WINDOW("OPEN", "MainPage", "");

    END IF

    ' Remove this cyclic task (only runs once after startup)
    CYCLIC("DEL", 10, "L_DistArch/GENERAL.SCB", "", "DualDisplay");

    ' Reset selection and restore focus to primary screen
    REGION("SETSELECTION", 0);
    REGION("SETREGION", 1);

End Sub


'---------------------------------------
' LogUser
'---------------------------------------
' Purpose:
'   Handle user login/logout events in redundant client-server setups.
'   - Triggers LAN.<Branch>.LOGIN or LAN.<Branch>.LOGOUT variables
'   - Stores user name, station, and running mode
'   - Adds cyclic program ResetTrigger() to reset the trigger bit
'
' Arguments:
'   BRANCH = Base branch name where LOGIN/LOGOUT variables are defined
'
' Notes:
'   - RunningMode is encoded as:
'       1 = CONSOLE
'       2 = SERVICE
'       3 = RDS
'   - Association name for redundancy is taken from ASSOC_RT
'   - LAN variables must exist in Application Architect
'---------------------------------------

Sub LogUser()

	Dim currBrch as Str;
	Dim varLogin as Str;
	Dim varLogout as Str;
	Dim varUser as Str;
	Dim varOnline as Str;
	Dim varStation as Str;
	Dim strVarUser as Str;
	Dim varTrigger as Str;
	Dim varRunningMode as Str;
	Dim RunningMode as Single;
			
	
		' === RETRIEVE ARGUMENTS ===
        ' Retrieve branch passed as argument
        currBrch = GETARG("BRANCH");

        ' === BUILD LAN VARIABLE NAMES ===
        ' Format: <Branch>.<VariableName>
		varLogin       = ADDSTRING(currBrch, ".LOGIN"); 		' User login trigger
		varLogout      = ADDSTRING(currBrch, ".LOGOUT"); 		' User logout trigger
		varOnline      = ADDSTRING(currBrch, ".ONLINE"); 	' Station online indicator
		varUser        = ADDSTRING(currBrch, ".UserConnected");  ' Current user name
		varRunningMode = ADDSTRING(currBrch, ".RUNNINGMODE");    ' Execution mode
		varStation     = VARIABLE("TATT",varOnline,3);  ' Extract station name from attribute

		' === RETRIEVE CURRENT VALUES ===
		strVarUser = (?varUser);         ' Get current user name
		RunningMode = (?varRunningMode); ' Get running mode (1=Console, 2=Service, 3=RDS)

        '---------------------------------------
        ' User LOGIN case (User is NOT DEFUSER)
        '---------------------------------------		
        IF ((CmpString(strVarUser, "DEFUSER") != 0)) Then

        	' === STORE LOGIN INFO ===
        	' Store user name in LOGIN variable attribute 3
			VARIABLE("SETTATT", VarLogin, 3, strVarUser);
			' Store station name in LOGIN variable attribute 4
			VARIABLE("SETTATT", VarLogin, 4, varStation);
		
            ' === STORE RUNNING MODE ===
            ' Store execution mode in LOGIN variable attribute 5
            IF (RunningMode == 1) THEN VARIABLE("SETTATT", varLogin, 5, "CONSOLE"); END IF
            IF (RunningMode == 2) THEN VARIABLE("SETTATT", varLogin, 5, "SERVICE"); END IF
            IF (RunningMode == 3) THEN VARIABLE("SETTATT", varLogin, 5, "RDS");     END IF

        	' === LOG AND TRIGGER ===
			TRACE("LOG",(ADDSTRING("--- REMOTE TRACE LOGIN --- ", varLogin, " - ", strVarUser)));
			' Schedule reset of LOGIN trigger after 1 second
			CYCLIC("ADDPROG", 1, "L_DistArch/GENERAL.SCB", currBrch, "ResetTrigger", "LOGIN" );
			' Set LOGIN trigger flag to 1
			?VarLogin = (1);

        '---------------------------------------
        ' User LOGOUT case (User IS DEFUSER or logged out)
        '---------------------------------------
		ELSE

        	' === STORE LOGOUT INFO ===
        	' Store user name in LOGOUT variable attribute 3
			VARIABLE("SETTATT", VarLogout, 3, strVarUser);
			' Store station name in LOGOUT variable attribute 4
			VARIABLE("SETTATT", VarLogout, 4, varStation);
		
            ' === STORE RUNNING MODE ===
            ' Store execution mode in LOGOUT variable attribute 5
            IF (RunningMode == 1) THEN VARIABLE("SETTATT", varLogout, 5, "CONSOLE"); END IF
            IF (RunningMode == 2) THEN VARIABLE("SETTATT", varLogout, 5, "SERVICE"); END IF
            IF (RunningMode == 3) THEN VARIABLE("SETTATT", varLogout, 5, "RDS");     END IF
            		
        	' === LOG AND TRIGGER ===		
			TRACE("LOG",(ADDSTRING("--- REMOTE TRACE LOGOFF --- ", varLogout, " - ", strVarUser)));
			' Schedule reset of LOGOUT trigger after 1 second
			CYCLIC("ADDPROG", 1, "L_DistArch/GENERAL.SCB", currBrch, "ResetTrigger", "LOGOUT" );
			' Set LOGOUT trigger flag to 1
			?varLogout = (1);

		END IF

End Sub


'---------------------------------------
' ResetTrigger
'---------------------------------------
' Purpose:
'   Reset trigger bits for LOGIN/LOGOUT events.
'   - Clears LAN.<Branch>.LOGIN or LAN.<Branch>.LOGOUT
'   - Ensures events are single-shot
'
' Arguments:
'   BRANCH = Base branch name
'   ARG1   = "LOGIN" or "LOGOUT"
'---------------------------------------

Sub ResetTrigger()

	Dim currBrch as Str;   ' Base branch name
	Dim varName as Str;    ' Variable name to reset
	Dim strArg1 as Str;    ' Trigger type: "LOGIN" or "LOGOUT"
	
	' === RETRIEVE ARGUMENTS ===
	strArg1 = GETARG("ARG1");   ' Get trigger type
	currBrch = GETARG("BRANCH");  ' Get branch name
	
	' === CLEANUP ===
	' Remove this cyclic task (executes once)
	CYCLIC("DEL", 1, "L_DistArch/GENERAL.SCB", currBrch, "ResetTrigger" );
	
	' === RESET TRIGGER ===
	' Construct variable name: <Branch>.<LOGIN|LOGOUT>
	varName=ADDSTRING(currBrch, ".",strArg1);				
	' Clear trigger flag to 0 (single-shot event)
	?varName = (0);

	' Log the reset action (optional)
End Sub


'---------------------------------------
' DualHardCopy
'---------------------------------------
' Purpose:
'   Take a screenshot of the current mimic window.
'   - Supports dual monitor setups
'   - Saves PNG files in project folder \HARDCOPY\
'
' Notes:
'   - Requires nircmd.exe in \TP\ folder of the library
'   - File names include station name and timestamp
'   - Region 1 = primary monitor, Region 2 = secondary monitor
'---------------------------------------
Sub DualHardCopy()

	Dim PrintLink as Str;   ' Full path to nircmd.exe (screenshot utility)
	Dim Filename as Str;    ' Screenshot command with parameters

	' === CONFIGURE SCREENSHOT TOOL ===
	' Path to nircmd.exe (must exist in \L_DistArch\TP\)
	PrintLink = GETPROJECTDIR();
	PrintLink = ADDSTRING(PrintLink,"\\LIB\\L_DistArch\\TP\\nircmd.exe");
	
    ' === BUILD SCREENSHOT COMMAND ===
    ' File naming: PROJECT\HARDCOPY\StationName-YYYY-MM-DD-HH-MM-SS.png
    ' Command: savescreenshot "<full_path_and_filename>" <left> <top> <right> <bottom>
	Filename = ADDSTRING("savescreenshot ","\"",GETPROJECTDIR(),"\\HARDCOPY\\");
	' Add station name prefix
	Filename = ADDSTRING(Filename,@SYSTEM.STATION_NAME,"-");
	' Add date/time stamp: YYYY-MM-DD-HH-MM-SS
	Filename = ADDSTRING(FileName, TOC(DATETIME("YEAR")), "-" , TOC(DATETIME("MONTH")),"-",TOC(DATETIME("DAY")),"-",TOC(DATETIME("HOUR")));
	Filename = ADDSTRING(FileName,"-",TOC(DATETIME("MINUTE")),"-",TOC(DATETIME("SECOND")),".png\"",);

    '---------------------------------------
    ' Select screenshot region based on current window region
    '---------------------------------------
	IF (WINDOW("GETREGION",WINDOW("CURRENTNAME"),WINDOW("CURRENTBRANCH")) == 1) Then
	
		' === REGION 1: PRIMARY MONITOR ===
		' Coordinates: 0 0 1920 1080 (standard 1920x1080 resolution)
		Filename = ADDSTRING(Filename, " 0 0 1920 1080");
		APPLICATION ("LOAD" , PrintLink , FileName);
		
	ELSE
	
		IF (WINDOW("GETREGION",WINDOW("CURRENTNAME"),WINDOW("CURRENTBRANCH")) == 2) Then
		
			' === REGION 2: SECONDARY MONITOR ===
			' Coordinates: 1921 0 3840 1080 (second monitor, offset by 1920 pixels)
			Filename = ADDSTRING(Filename, " 1921 0 3840 1080");
			APPLICATION ("LOAD" , PrintLink , FileName);
		END IF
	
	END IF
	
End Sub

